#!/usr/bin/python3 -I
# Starts one RomM game in RetroDECK. Steam runs this with a single argument: the game's number in
# RomM. Where its file is comes from a private list Vistazo's backend keeps beside this launcher,
# and the file goes to RetroDECK as one argument of its own: no file name ever reaches a shell or
# Steam's launch options.
import json
import os
import stat
import sys

RETRODECK = "net.retrodeck.retrodeck"


def fail(why):
    sys.stderr.write("vistazo-launch: %s\n" % why)
    return 2


def game_path(table_file, rom_id):
    """The file of that game, or None with the reason."""
    if not (rom_id.isascii() and rom_id.isdigit() and len(rom_id) <= 12):
        return None, "not a game number"
    try:
        info = os.lstat(table_file)
        # Only a plain file of this user that nobody else can write is believed.
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o022:
            return None, "the game list is not private"
        with open(table_file, encoding="utf-8") as f:
            table = json.load(f)
    except (OSError, ValueError):
        return None, "no game list"
    path = table.get(rom_id) if isinstance(table, dict) else None
    if not isinstance(path, str) or not os.path.isabs(path) or "\0" in path:
        return None, "game not installed"
    if not os.path.isfile(path):
        return None, "the game's file is gone"
    return path, None


def main(argv):
    if len(argv) != 2:
        return fail("expected one game number")
    here = os.path.dirname(os.path.realpath(__file__))
    path, why = game_path(os.path.join(here, "launch.json"), argv[1])
    if path is None:
        return fail(why)
    env = dict(os.environ)
    # Steam's own libraries and overlay are for the games it starts, not for flatpak.
    for name in ("LD_PRELOAD", "LD_LIBRARY_PATH"):
        env.pop(name, None)
    try:
        os.execvpe("flatpak", ["flatpak", "run", RETRODECK, path], env)
    except OSError as e:
        return fail("flatpak did not start: %s" % e)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
